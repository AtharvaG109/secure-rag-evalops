QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=securerag_chunks
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/securerag
EMBEDDING_PROVIDER=local_hash
GENERATION_PROVIDER=extractive
EMBEDDING_DIMENSIONS=3072
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_CHAT_MODEL=gemma3
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=8
MMR_LAMBDA=0.5
MMR_K=6
CHAT_INPUT_PRICE_PER_1M=0.0
CHAT_OUTPUT_PRICE_PER_1M=0.0
EMBEDDING_PRICE_PER_1M=0.0
LOG_LEVEL=INFO
ENVIRONMENT=local
RUN_MIGRATIONS_ON_STARTUP=false
ALLOW_LOCAL_DEV_AUTH=true
LOCAL_DEV_USER_ID=demo-admin
AUTH_TOKEN_PEPPER=dev-only-change-me
MAX_REQUEST_BYTES=10000000
MAX_INGEST_CONTENT_CHARS=10000000
RATE_LIMIT_PER_MINUTE=0
TRUSTED_HOSTS=*
