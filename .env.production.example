QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=replace-me
QDRANT_COLLECTION=securerag_chunks
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://securerag:replace-me@postgres:5432/securerag
POSTGRES_PASSWORD=replace-me
EMBEDDING_PROVIDER=ollama
GENERATION_PROVIDER=ollama
EMBEDDING_DIMENSIONS=768
OLLAMA_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=replace-me
OLLAMA_CHAT_MODEL=replace-me
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=8
MMR_LAMBDA=0.5
MMR_K=6
CHAT_INPUT_PRICE_PER_1M=0.0
CHAT_OUTPUT_PRICE_PER_1M=0.0
EMBEDDING_PRICE_PER_1M=0.0
LOG_LEVEL=INFO
ENVIRONMENT=production
RUN_MIGRATIONS_ON_STARTUP=false
ALLOW_LOCAL_DEV_AUTH=false
LOCAL_DEV_USER_ID=demo-admin
AUTH_TOKEN_PEPPER=replace-with-long-random-secret
MAX_REQUEST_BYTES=10000000
MAX_INGEST_CONTENT_CHARS=10000000
RATE_LIMIT_PER_MINUTE=120
TRUSTED_HOSTS=rag.internal.example.com
